{
  "name": "antigravity-tokendashboard",
  "displayName": "Antigravity Token & Cost Intelligence",
  "description": "Native in-IDE Token, Cost, Prompt Cache & CO2e intelligence dashboard for Antigravity IDE.",
  "version": "1.0.0",
  "publisher": "www-diogo-in",
  "author": "Diogo",
  "license": "MIT",
  "homepage": "https://github.com/www-diogo-in/antigravity-tokendashboard#readme",
  "repository": {
    "type": "git",
    "url": "https://github.com/www-diogo-in/antigravity-tokendashboard.git"
  },
  "bugs": {
    "url": "https://github.com/www-diogo-in/antigravity-tokendashboard/issues"
  },
  "qna": "https://github.com/www-diogo-in/antigravity-tokendashboard/issues",
  "categories": [
    "Other",
    "Visualization"
  ],
  "keywords": [
    "antigravity",
    "tokens",
    "cost",
    "analytics",
    "dashboard",
    "gemini",
    "claude",
    "co2",
    "ai-usage"
  ],
  "icon": "assets/icon.png",
  "galleryBanner": {
    "color": "#080c14",
    "theme": "dark"
  },
  "badges": [
    {
      "url": "https://img.shields.io/badge/License-MIT-blue.svg",
      "href": "https://github.com/www-diogo-in/antigravity-tokendashboard/blob/main/LICENSE",
      "description": "License"
    },
    {
      "url": "https://img.shields.io/badge/Privacy-100%25%20On--Device-brightgreen.svg",
      "href": "https://github.com/www-diogo-in/antigravity-tokendashboard#privacy--security-architecture",
      "description": "Privacy"
    }
  ],
  "engines": {
    "vscode": "^1.90.0"
  },
  "main": "./extension.js",
  "activationEvents": [
    "onStartupFinished"
  ],
  "contributes": {
    "configuration": {
      "title": "Antigravity Token Intelligence",
      "properties": {
        "antigravity.tokenDashboard.defaultRange": {
          "type": "string",
          "default": "30d",
          "enum": [
            "today",
            "7d",
            "30d",
            "all"
          ],
          "enumDescriptions": [
            "Last 24 hours of telemetry",
            "Last 7 days of telemetry",
            "Last 30 days of telemetry",
            "All-time historical telemetry"
          ],
          "description": "Default time period range displayed in KPI overview and status bar."
        },
        "antigravity.tokenDashboard.port": {
          "type": "number",
          "default": 3333,
          "description": "Local port number used by the SQLite telemetry analytics server."
        },
        "antigravity.tokenDashboard.autoStartServer": {
          "type": "boolean",
          "default": true,
          "description": "Automatically spawn the local analytics server if not already active."
        }
      }
    },
    "viewsContainers": {
      "activitybar": [
        {
          "id": "antigravity-tokendashboard-container",
          "title": "Token Intelligence",
          "icon": "assets/icon.svg"
        }
      ]
    },
    "views": {
      "antigravity-tokendashboard-container": [
        {
          "type": "webview",
          "id": "antigravity.tokenDashboardSidebar",
          "name": "Token & Cost Intelligence",
          "icon": "assets/icon.svg"
        }
      ]
    },
    "commands": [
      {
        "command": "antigravity.openTokenDashboard",
        "title": "Open Token & Cost Dashboard",
        "category": "Antigravity",
        "icon": "$(dashboard)"
      },
      {
        "command": "antigravity.refreshTokenTelemetry",
        "title": "Refresh Token Telemetry",
        "category": "Antigravity",
        "icon": "$(refresh)"
      },
      {
        "command": "antigravity.restartTokenServer",
        "title": "Restart Token Dashboard Server",
        "category": "Antigravity",
        "icon": "$(sync)"
      }
    ],
    "menus": {
      "commandPalette": [
        {
          "command": "antigravity.openTokenDashboard"
        },
        {
          "command": "antigravity.refreshTokenTelemetry"
        },
        {
          "command": "antigravity.restartTokenServer"
        }
      ],
      "view/title": [
        {
          "command": "antigravity.openTokenDashboard",
          "when": "view == antigravity.tokenDashboardSidebar",
          "group": "navigation"
        },
        {
          "command": "antigravity.refreshTokenTelemetry",
          "when": "view == antigravity.tokenDashboardSidebar",
          "group": "navigation"
        }
      ]
    }
  }
}